// -*- mode: json -*-

{
    "layer": "top",
    "position": "top",
    "spacing": 1,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
    ],
    "modules-center": [
    ],
    "modules-right": [
        "custom/update",
        "pulseaudio",
        "memory",
        "cpu",
        "network",
        "battery",
        "clock",
        "tray"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "custom/update":{
        "format":"{}",
        "return-type":"json",
        "exec":"python ~/.config/waybar/scripts/get_update.py",
        "interval": 300,
    },
    "pulseaudio": {
        "format": "{icon} {volume:2}%",
        "format-bluetooth": "{icon}  {volume}%",
        "format-muted": "MUTE",
        "format-icons": {
            "headphones": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    "memory": {
        // "format": "Mem:{}%",
        "format-critical":  "<span color='#c20821'><b>Mem:{}%</b></span>",
        "format-high":      "<span color='#e03c52'>Mem:{}%</span>",
        "format-medium":    "<span color='#85c600'>Mem:{}%</span>",
        "format-low":       "<span color='grey'>Mem:LOW</span>",
        "tooltip": false,
        "interval": 5,
        "states": {
            "critical": 80,
            "high": 50,
            "medium": 15,
            "low": 0,
        },
    },
    "cpu": {
        // "format": "{usage:2}%",
        "format-critical":  "<span color='#c20821'><b>CPU:MAX</b></span>",
        "format-high":      "<span color='#e03c52'>CPU:HIGH</span>",
        "format-medium":    "<span color='#85c600'>CPU:MED</span>",
        "format-low":       "<span color='grey'>CPU:LOW</span>",
        "tooltip": false,
        "interval": 2,
        "states": {
            "critical": 80,
            "high": 50,
            "medium": 15,
            "low": 0,
        },
    },
    "network": {
        // "interface": "wlp2s0", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ",
        "tooltip-format": "{essid} {signalStrength}%",
        "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
        "format-disconnected": "Disconnected ⚠",
        "interval" : 7,
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "clock": {
        "interval":1,
        "format": "{:%m/%d%a %H:%M}",
        "tooltip-format": "{:%H:%M:%S}",
        "on-click":"xdg-open 'https://calendar.google.com/calendar'"
    },
    "tray": {
        "icon-size": 20
    }
}
